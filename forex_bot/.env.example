# =============================================================================
# FxBot Environment Variables - EXAMPLE FILE
# =============================================================================
# Copy this file to ".env" and fill in your real credentials.
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# The .gitignore already excludes .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# OANDA Broker Credentials
# -----------------------------------------------------------------------------
# How to get these:
#   1. Sign up at https://www.oanda.com/
#   2. For practice (paper) trading: https://fxtrade.oanda.com/your_account/fxtrade/register/gate
#   3. Log in and go to: My Account -> Manage API Access -> Generate API Key
#   4. Your Account ID is shown on the same page (a numeric string like "101-001-1234567-001")
#   5. Set OANDA_ENVIRONMENT=practice for paper trading, =live for real money

OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_API_KEY=your_oanda_api_key_here

# "practice" = paper trading (recommended to start)
# "live"     = real money trading (use with extreme caution)
OANDA_ENVIRONMENT=practice

# -----------------------------------------------------------------------------
# MetaTrader 5 Credentials (optional secondary broker)
# -----------------------------------------------------------------------------
# How to get these:
#   1. Download MT5 from your broker's website or https://www.metatrader5.com/
#   2. Open an account with an MT5-compatible broker
#   3. MT5_LOGIN = your numeric account number (shown in MT5 top-left)
#   4. MT5_PASSWORD = the password you set when creating the account
#   5. MT5_SERVER = the server name shown when logging in (e.g. "ICMarketsSC-Demo")
# Note: MT5 Python API only works on Windows natively. Use Wine or a Windows VM on Linux.

MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_broker_server

# -----------------------------------------------------------------------------
# Telegram Bot Notifications
# -----------------------------------------------------------------------------
# How to get these:
#   1. Open Telegram and search for "@BotFather"
#   2. Send /newbot and follow the prompts to create a bot
#   3. BotFather will give you the bot token (format: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
#   4. Start a conversation with your bot or add it to a group
#   5. To get your Chat ID:
#      - Send a message to your bot
#      - Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      - Look for "chat": {"id": <YOUR_CHAT_ID>}
#   6. For group chats, the chat_id is negative (e.g., -1001234567890)

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Email Notifications (Gmail SMTP)
# -----------------------------------------------------------------------------
# How to set up Gmail app password:
#   1. Enable 2-factor authentication on your Google account
#      https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Select "Mail" and your device, then click "Generate"
#   4. Copy the 16-character app password (spaces don't matter)
#   5. Use that app password as EMAIL_PASSWORD (NOT your regular Gmail password)
#
# For other email providers change EMAIL_SMTP_HOST and EMAIL_SMTP_PORT:
#   Outlook/Hotmail: smtp-mail.outlook.com : 587
#   Yahoo Mail:      smtp.mail.yahoo.com   : 587
#   Custom/Business: check with your provider

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=recipient@email.com

# -----------------------------------------------------------------------------
# News / Economic Calendar API
# -----------------------------------------------------------------------------
# How to get NewsAPI key (optional - for general financial news):
#   1. Sign up at https://newsapi.org/
#   2. Verify your email and log in
#   3. Go to https://newsapi.org/account and copy your API key
#   Note: Free tier allows 100 requests/day. Upgrade for more.
#
# For ForexFactory data (no key required - scraped) leave this blank:
#   NEWS_API_KEY=
#
# For Investing.com calendar (no official key) leave this blank as well.

NEWS_API_KEY=your_newsapi_key_here

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default, no setup required):
#   DATABASE_URL=sqlite:///forex_bot.db
#
# PostgreSQL (recommended for production):
#   DATABASE_URL=postgresql://user:password@localhost:5432/forex_bot
#
# MySQL:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/forex_bot

DATABASE_URL=sqlite:///forex_bot.db

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG only during development (very verbose).
# INFO is recommended for normal operation.

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Trading Mode
# -----------------------------------------------------------------------------
# true  = paper trading (no real money at risk) - ALWAYS start here
# false = live trading (real money) - only after thorough testing

PAPER_TRADING=true
